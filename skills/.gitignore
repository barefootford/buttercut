# Ignore everything by default — user-created skills stay local.
*

# Track this file itself.
!.gitignore

# Allowlist of shipped skills. For each, two lines are needed: the trailing-slash
# entry un-ignores the directory itself, and the /** entry un-ignores its
# contents (otherwise the `*` above re-matches files inside). When shipping a
# new skill, add both lines.
!analyze-video/
!analyze-video/**
!backup-library/
!backup-library/**
!release/
!release/**
!cut/
!cut/**
!setup/
!setup/**
!transcribe-audio/
!transcribe-audio/**
!update-buttercut/
!update-buttercut/**
!full-transcript/
!full-transcript/**
!contact-sheet/
!contact-sheet/**
!create-library/
!create-library/**
!process-library/
!process-library/**
!reprocess-with-contact-sheets/
!reprocess-with-contact-sheets/**
!misc-task/
!misc-task/**
